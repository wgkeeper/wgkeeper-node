# Caddy gets and renews a Let's Encrypt certificate for this domain
# automatically when ports 80 and 443 are reachable.
api.example.com {
	encode gzip zstd

	# Optional: allow only your orchestrator. Everyone else is dropped before
	# reaching the node.
	# @blocked not remote_ip 203.0.113.7
	# abort @blocked

	# Caddy shares the node's network namespace (see docker-compose.prod-secure.yml),
	# so the API is on loopback. Port must match server.port in config.yaml.
	reverse_proxy 127.0.0.1:51821
}
